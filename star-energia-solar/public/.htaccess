# STAR Energia Solar - configuração para hospedagem Apache (cPanel)

# Página de erro
ErrorDocument 404 /404.html

# Endereços antigos
RedirectMatch 301 ^/manutencao-de-energia-solar/?$ /manutencao-energia-solar/

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Cache: arquivos com hash no nome podem ficar em cache por 1 ano; HTML é sempre revalidado
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
